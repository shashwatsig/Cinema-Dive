# Cinema Dive — Backend Environment Variables

# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/cinemadive

# TMDB API — get a free key at https://www.themoviedb.org/settings/api
# Use the Read Access Token (v4 Bearer) — preferred
TMDB_API_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here
# OR use the v3 API key (shorter string)
# TMDB_API_KEY=your_tmdb_api_key_here

# JWT secret — use a long random string
JWT_SECRET=change_this_to_a_long_random_secret

# Server port (optional, defaults to 5000)
PORT=5000

# Allowed frontend origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Node environment
NODE_ENV=development
